{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opui-v1.schema.json",
  "title": "openpencil-runtime-ui",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "generator",
    "document",
    "entrypoints",
    "assets",
    "nodes",
    "diagnostics",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "openpencil-runtime-ui"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "entrypoints": {
      "$ref": "#/$defs/entrypoints"
    },
    "assets": {
      "$ref": "#/$defs/assetMap"
    },
    "nodes": {
      "$ref": "#/$defs/nodeMap"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensionMap"
    }
  },
  "$defs": {
    "iJsonInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "iJsonNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "iJsonPositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "finiteNumber": {
      "type": "number"
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$"
    },
    "nullableRuntimeId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/runtimeId"
        }
      ]
    },
    "nullableSourceId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sourceId"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^(image|font|vector|raster_fallback)-[a-f0-9]{64}$"
    },
    "imageOrVectorAssetId": {
      "type": "string",
      "pattern": "^(image|vector)-[a-f0-9]{64}$"
    },
    "fontAssetId": {
      "type": "string",
      "pattern": "^font-[a-f0-9]{64}$"
    },
    "rasterFallbackAssetId": {
      "type": "string",
      "pattern": "^raster_fallback-[a-f0-9]{64}$"
    },
    "assetUri": {
      "type": "string",
      "pattern": "^(images|fonts|vectors|fallback)/[a-f0-9]{64}\\.(png|jpg|webp|ttf|otf|woff2|svg)$"
    },
    "reverseDomain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "extensionMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/reverseDomain"
      },
      "additionalProperties": true
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference_viewport"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference_viewport": {
          "$ref": "#/$defs/referenceViewport"
        }
      }
    },
    "referenceViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/sourceId"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/sourceId"
      }
    },
    "nodeMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/sourceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "assetMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/assetId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_id",
        "visible",
        "children",
        "layout",
        "style",
        "extensions"
      ],
      "properties": {
        "type": {
          "enum": [
            "container",
            "text",
            "image",
            "fallback"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "runtime_id": {
          "$ref": "#/$defs/runtimeId"
        },
        "name": {
          "type": "string"
        },
        "component": {
          "$ref": "#/$defs/componentMetadata"
        },
        "visible": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "extensions": {
          "$ref": "#/$defs/extensionMap"
        },
        "container": {
          "$ref": "#/$defs/containerPayload"
        },
        "text": {
          "$ref": "#/$defs/textPayload"
        },
        "image": {
          "$ref": "#/$defs/imagePayload"
        },
        "fallback": {
          "$ref": "#/$defs/fallbackPayload"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "container"
            ],
            "properties": {
              "text": false,
              "image": false,
              "fallback": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "container": false,
              "image": false,
              "fallback": false,
              "children": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "image"
            ],
            "properties": {
              "container": false,
              "text": false,
              "fallback": false,
              "children": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fallback"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fallback"
            ],
            "properties": {
              "container": false,
              "text": false,
              "image": false,
              "children": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "componentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "definition_source_id",
        "component_name",
        "variant_properties"
      ],
      "properties": {
        "role": {
          "const": "instance"
        },
        "definition_source_id": {
          "type": "string",
          "minLength": 1
        },
        "component_name": {
          "type": "string",
          "minLength": 1
        },
        "variant_properties": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "containerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "enum": [
            "flex",
            "grid",
            "absolute",
            "none"
          ]
        },
        "position": {
          "enum": [
            "flow",
            "absolute"
          ]
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "width": {
          "$ref": "#/$defs/lengthPxPercentAutoFill"
        },
        "height": {
          "$ref": "#/$defs/lengthPxPercentAutoFill"
        },
        "min_width": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        },
        "min_height": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        },
        "max_width": {
          "$ref": "#/$defs/lengthPxPercentNone"
        },
        "max_height": {
          "$ref": "#/$defs/lengthPxPercentNone"
        },
        "padding": {
          "$ref": "#/$defs/edgesPxPercent"
        },
        "margin": {
          "$ref": "#/$defs/edgesPxPercentAuto"
        },
        "inset": {
          "$ref": "#/$defs/edgesPxPercentAuto"
        },
        "flex_direction": {
          "enum": [
            "row",
            "row_reverse",
            "column",
            "column_reverse"
          ]
        },
        "flex_wrap": {
          "enum": [
            "nowrap",
            "wrap",
            "wrap_reverse"
          ]
        },
        "flex_grow": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "flex_shrink": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "flex_basis": {
          "$ref": "#/$defs/lengthPxPercentAutoFill"
        },
        "justify_content": {
          "$ref": "#/$defs/justifyContent"
        },
        "justify_items": {
          "$ref": "#/$defs/alignItems"
        },
        "justify_self": {
          "$ref": "#/$defs/alignSelf"
        },
        "align_content": {
          "$ref": "#/$defs/justifyContent"
        },
        "align_items": {
          "$ref": "#/$defs/alignItems"
        },
        "align_self": {
          "$ref": "#/$defs/alignSelf"
        },
        "gap": {
          "$ref": "#/$defs/gap"
        },
        "grid_template_columns": {
          "$ref": "#/$defs/trackList"
        },
        "grid_template_rows": {
          "$ref": "#/$defs/trackList"
        },
        "grid_auto_flow": {
          "enum": [
            "row",
            "column",
            "row_dense",
            "column_dense"
          ]
        },
        "grid_column": {
          "$ref": "#/$defs/gridPlacement"
        },
        "grid_row": {
          "$ref": "#/$defs/gridPlacement"
        },
        "aspect_ratio": {
          "$ref": "#/$defs/aspectRatio"
        },
        "z_index": {
          "$ref": "#/$defs/iJsonInteger"
        }
      }
    },
    "justifyContent": {
      "enum": [
        "start",
        "end",
        "center",
        "stretch",
        "space_between",
        "space_around",
        "space_evenly"
      ]
    },
    "alignItems": {
      "enum": [
        "start",
        "end",
        "center",
        "stretch",
        "baseline"
      ]
    },
    "alignSelf": {
      "enum": [
        "auto",
        "start",
        "end",
        "center",
        "stretch",
        "baseline"
      ]
    },
    "lengthPx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "px"
        },
        "value": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "lengthPxNonNegative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "px"
        },
        "value": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "lengthPxPercent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "px",
            "percent"
          ]
        },
        "value": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "lengthPxPercentNonNegative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "px",
            "percent"
          ]
        },
        "value": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "lengthAuto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "auto"
        }
      }
    },
    "lengthNone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "lengthFill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "weight"
      ],
      "properties": {
        "type": {
          "const": "fill"
        },
        "weight": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "lengthFr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "fr"
        },
        "value": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "lengthPxPercentAuto": {
      "oneOf": [
        {
          "$ref": "#/$defs/lengthPxPercent"
        },
        {
          "$ref": "#/$defs/lengthAuto"
        }
      ]
    },
    "lengthPxPercentAutoFill": {
      "oneOf": [
        {
          "$ref": "#/$defs/lengthPxPercent"
        },
        {
          "$ref": "#/$defs/lengthAuto"
        },
        {
          "$ref": "#/$defs/lengthFill"
        }
      ]
    },
    "lengthPxPercentNone": {
      "oneOf": [
        {
          "$ref": "#/$defs/lengthPxPercent"
        },
        {
          "$ref": "#/$defs/lengthNone"
        }
      ]
    },
    "edgesPxPercent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "right": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "bottom": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "left": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        }
      }
    },
    "edgesPxPercentAuto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        },
        "right": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        },
        "bottom": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        },
        "left": {
          "$ref": "#/$defs/lengthPxPercentAuto"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column"
      ],
      "properties": {
        "row": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "column": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        }
      }
    },
    "trackList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trackSize"
      }
    },
    "trackSize": {
      "oneOf": [
        {
          "$ref": "#/$defs/lengthPxPercent"
        },
        {
          "$ref": "#/$defs/lengthFr"
        },
        {
          "$ref": "#/$defs/lengthAuto"
        },
        {
          "$ref": "#/$defs/minmax"
        }
      ]
    },
    "minmax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "min",
        "max"
      ],
      "properties": {
        "type": {
          "const": "minmax"
        },
        "min": {
          "oneOf": [
            {
              "$ref": "#/$defs/lengthPxPercent"
            },
            {
              "$ref": "#/$defs/lengthFr"
            },
            {
              "$ref": "#/$defs/lengthAuto"
            }
          ]
        },
        "max": {
          "oneOf": [
            {
              "$ref": "#/$defs/lengthPxPercent"
            },
            {
              "$ref": "#/$defs/lengthFr"
            },
            {
              "$ref": "#/$defs/lengthAuto"
            },
            {
              "$ref": "#/$defs/lengthNone"
            }
          ]
        }
      }
    },
    "gridPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/gridLine"
        },
        "end": {
          "$ref": "#/$defs/gridLine"
        }
      }
    },
    "gridLine": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "auto"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "line"
            },
            "value": {
              "$ref": "#/$defs/iJsonInteger",
              "not": {
                "const": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "span"
            },
            "value": {
              "$ref": "#/$defs/iJsonPositiveInteger"
            }
          }
        }
      ]
    },
    "aspectRatio": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "auto"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "ratio"
            },
            "value": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": {
          "$ref": "#/$defs/unitInterval"
        },
        "clipping": {
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/fill"
        },
        "border": {
          "$ref": "#/$defs/border"
        },
        "corner_radius": {
          "$ref": "#/$defs/cornerRadius"
        },
        "outer_shadows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outerShadow"
          }
        },
        "translation": {
          "$ref": "#/$defs/translation"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "transform_origin": {
          "$ref": "#/$defs/transformOrigin"
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space",
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "space": {
          "enum": [
            "srgb",
            "srgb-linear"
          ]
        },
        "r": {
          "$ref": "#/$defs/unitInterval"
        },
        "g": {
          "$ref": "#/$defs/unitInterval"
        },
        "b": {
          "$ref": "#/$defs/unitInterval"
        },
        "a": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/finiteNumber"
        },
        "y": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "positivePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/positiveNumber"
        },
        "y": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "colorStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "color"
      ],
      "properties": {
        "offset": {
          "$ref": "#/$defs/unitInterval"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "colorStops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/colorStop"
      }
    },
    "fill": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "linear"
            },
            "start": {
              "$ref": "#/$defs/normalizedPoint"
            },
            "end": {
              "$ref": "#/$defs/normalizedPoint"
            },
            "stops": {
              "$ref": "#/$defs/colorStops"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "center",
            "radius",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "radial"
            },
            "center": {
              "$ref": "#/$defs/normalizedPoint"
            },
            "radius": {
              "$ref": "#/$defs/positivePoint"
            },
            "stops": {
              "$ref": "#/$defs/colorStops"
            }
          }
        }
      ]
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "style",
        "color"
      ],
      "properties": {
        "width": {
          "$ref": "#/$defs/lengthPxNonNegative"
        },
        "style": {
          "enum": [
            "none",
            "solid"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "cornerRadius": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_left",
        "top_right",
        "bottom_right",
        "bottom_left"
      ],
      "properties": {
        "top_left": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "top_right": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "bottom_right": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        },
        "bottom_left": {
          "$ref": "#/$defs/lengthPxPercentNonNegative"
        }
      }
    },
    "outerShadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset_x",
        "offset_y",
        "blur",
        "spread",
        "color"
      ],
      "properties": {
        "offset_x": {
          "$ref": "#/$defs/lengthPx"
        },
        "offset_y": {
          "$ref": "#/$defs/lengthPx"
        },
        "blur": {
          "$ref": "#/$defs/lengthPxNonNegative"
        },
        "spread": {
          "$ref": "#/$defs/lengthPx"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/lengthPx"
        },
        "y": {
          "$ref": "#/$defs/lengthPx"
        }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degrees"
      ],
      "properties": {
        "degrees": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/finiteNumber"
        },
        "y": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "transformOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/unitInterval"
        },
        "y": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "textPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "defaults",
        "runs",
        "align_horizontal",
        "align_vertical",
        "wrap",
        "overflow"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "defaults": {
          "$ref": "#/$defs/textStyle"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textRun"
          }
        },
        "align_horizontal": {
          "enum": [
            "start",
            "center",
            "end",
            "justify"
          ]
        },
        "align_vertical": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "wrap": {
          "enum": [
            "wrap",
            "nowrap"
          ]
        },
        "overflow": {
          "enum": [
            "clip",
            "ellipsis"
          ]
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight",
        "font_style",
        "size",
        "color",
        "letter_spacing",
        "line_height"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/fontAssetId"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "font_style": {
          "enum": [
            "normal",
            "italic"
          ]
        },
        "size": {
          "$ref": "#/$defs/lengthPxNonNegative"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "letter_spacing": {
          "$ref": "#/$defs/lengthPx"
        },
        "line_height": {
          "$ref": "#/$defs/lineHeight"
        }
      }
    },
    "textStyleOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/fontAssetId"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "font_style": {
          "enum": [
            "normal",
            "italic"
          ]
        },
        "size": {
          "$ref": "#/$defs/lengthPxNonNegative"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "letter_spacing": {
          "$ref": "#/$defs/lengthPx"
        },
        "line_height": {
          "$ref": "#/$defs/lineHeight"
        }
      }
    },
    "lineHeight": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "normal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "multiple"
            },
            "value": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "px"
            },
            "value": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        }
      ]
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "style"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        },
        "end": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        },
        "style": {
          "$ref": "#/$defs/textStyleOverrides"
        }
      }
    },
    "imagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "intrinsic_width",
        "intrinsic_height",
        "fit",
        "nine_slice",
        "tint"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/imageOrVectorAssetId"
        },
        "intrinsic_width": {
          "$ref": "#/$defs/iJsonPositiveInteger"
        },
        "intrinsic_height": {
          "$ref": "#/$defs/iJsonPositiveInteger"
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "fill",
            "none"
          ]
        },
        "nine_slice": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nineSlice"
            }
          ]
        },
        "tint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/color"
            }
          ]
        }
      }
    },
    "nineSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        },
        "right": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        },
        "bottom": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        },
        "left": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        }
      }
    },
    "fallbackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "intrinsic_width",
        "intrinsic_height"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/rasterFallbackAssetId"
        },
        "intrinsic_width": {
          "$ref": "#/$defs/iJsonPositiveInteger"
        },
        "intrinsic_height": {
          "$ref": "#/$defs/iJsonPositiveInteger"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "mime_type",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "font",
            "vector",
            "raster_fallback"
          ]
        },
        "uri": {
          "$ref": "#/$defs/assetUri"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "font/ttf",
            "font/otf",
            "font/woff2",
            "image/svg+xml"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "$ref": "#/$defs/iJsonNonNegativeInteger"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "image"
            },
            "uri": {
              "type": "string",
              "pattern": "^images/[a-f0-9]{64}\\.png$"
            },
            "mime_type": {
              "const": "image/png"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "image"
            },
            "uri": {
              "type": "string",
              "pattern": "^images/[a-f0-9]{64}\\.jpg$"
            },
            "mime_type": {
              "const": "image/jpeg"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "image"
            },
            "uri": {
              "type": "string",
              "pattern": "^images/[a-f0-9]{64}\\.webp$"
            },
            "mime_type": {
              "const": "image/webp"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "font"
            },
            "uri": {
              "type": "string",
              "pattern": "^fonts/[a-f0-9]{64}\\.ttf$"
            },
            "mime_type": {
              "const": "font/ttf"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "font"
            },
            "uri": {
              "type": "string",
              "pattern": "^fonts/[a-f0-9]{64}\\.otf$"
            },
            "mime_type": {
              "const": "font/otf"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "font"
            },
            "uri": {
              "type": "string",
              "pattern": "^fonts/[a-f0-9]{64}\\.woff2$"
            },
            "mime_type": {
              "const": "font/woff2"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "vector"
            },
            "uri": {
              "type": "string",
              "pattern": "^vectors/[a-f0-9]{64}\\.svg$"
            },
            "mime_type": {
              "const": "image/svg+xml"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "raster_fallback"
            },
            "uri": {
              "type": "string",
              "pattern": "^fallback/[a-f0-9]{64}\\.png$"
            },
            "mime_type": {
              "const": "image/png"
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "node_id",
        "runtime_id",
        "message",
        "strategy",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "node_id": {
          "$ref": "#/$defs/nullableSourceId"
        },
        "runtime_id": {
          "$ref": "#/$defs/nullableRuntimeId"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": [
            "native",
            "raster_fallback",
            "error",
            "none"
          ]
        },
        "details": {
          "$ref": "#/$defs/extensionMap"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "error"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "error"
              }
            }
          }
        }
      ]
    },
    "diagnosticCode": {
      "enum": [
        "opui.schema",
        "opui.encoding",
        "opui.duplicate_json_key",
        "opui.key_order",
        "opui.indent",
        "opui.non_finite",
        "opui.negative_zero",
        "opui.number_normalization",
        "opui.duplicate_runtime_id",
        "opui.node_key_mismatch",
        "opui.asset_key_mismatch",
        "opui.unknown_child",
        "opui.duplicate_child",
        "opui.multiple_parents",
        "opui.cycle",
        "opui.unreachable_node",
        "opui.unknown_entrypoint",
        "opui.entrypoint_not_root",
        "opui.package_name",
        "opui.unresolved_asset",
        "opui.unresolved_font",
        "opui.unresolved_image",
        "opui.asset_kind_mismatch",
        "opui.asset_id_rule",
        "opui.asset_uri_rule",
        "opui.asset_mime_mapping",
        "opui.asset_hash_mismatch",
        "opui.asset_byte_length",
        "opui.asset_missing",
        "opui.network_uri",
        "opui.embedded_data",
        "opui.svg_invalid",
        "opui.svg_script",
        "opui.svg_animation",
        "opui.svg_event",
        "opui.svg_foreign_object",
        "opui.svg_dtd",
        "opui.svg_css",
        "opui.svg_external_ref",
        "opui.text_run_range",
        "opui.text_run_overlap",
        "opui.text_run_empty",
        "opui.text_run_order",
        "opui.text_run_scalar",
        "opui.font_unavailable",
        "opui.length_context",
        "opui.nine_slice_bounds",
        "opui.gradient_stop_order",
        "opui.unsupported_native",
        "opui.unsupported_raster_fallback",
        "opui.unsupported_error",
        "opui.mask_unsupported",
        "opui.effect_unsupported",
        "opui.path_unsupported",
        "opui.rasterization",
        "opui.fallback_diagnostic_count",
        "opui.diagnostic_node",
        "opui.diagnostic_runtime_id",
        "opui.diagnostic_order",
        "opui.diagnostic_strategy"
      ]
    }
  }
}
